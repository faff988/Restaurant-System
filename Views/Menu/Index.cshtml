@model List<RestaurantSystem.Models.MenuItem>
@{ViewData["Title"] = "Menu";}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="fas fa-book-open me-2 text-danger"></i>Menu</h2>
    @if (User.IsInRole("Admin"))
    {
        <a href="/Menu/Create" class="btn btn-primary"><i class="fas fa-plus me-2"></i>Add Item</a>
    }
</div>
<div class="row g-4">
    @foreach (var item in Model)
    {
        <div class="col-md-4">
            <div class="card h-100" style="overflow:hidden;">
                @if (!string.IsNullOrEmpty(item.ImageUrl))
                {
                    <img src="@item.ImageUrl" alt="@item.Name" style="height:200px; width:100%; object-fit:cover;" />
                }
                else
                {
                    <div class="text-center py-4" style="background:#f8f9fa; font-size:4rem;">🍽️</div>
                }
                <div class="p-3">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <h5 class="fw-bold mb-0">@item.Name</h5>
                        <span class="badge bg-danger">@item.Category</span>
                    </div>
                    <p class="text-muted small mb-2">@item.Description</p>
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <h5 class="text-danger fw-bold mb-0">$@item.Price.ToString("0.00")</h5>
                        <span class="badge @(item.IsAvailable ? "bg-success" : "bg-secondary")">
                            @(item.IsAvailable ? "Available" : "Unavailable")
                        </span>
                    </div>
                    @if (User.IsInRole("Admin"))
                    {
                        <div class="d-flex gap-2 mt-2">
                            <a href="/Menu/Edit/@item.Id" class="btn btn-sm btn-outline-primary w-50"><i class="fas fa-edit"></i> Edit</a>
                            <a href="/Menu/Delete/@item.Id" class="btn btn-sm btn-outline-danger w-50" onclick="return confirm('Delete this item?')"><i class="fas fa-trash"></i> Delete</a>
                        </div>
                    }
                </div>
            </div>
        </div>
    }
</div>