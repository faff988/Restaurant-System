@model RestaurantSystem.Models.Order
@{ViewData["Title"] = "Order Details";}
<div class="row justify-content-center">
    <div class="col-md-7">
        <div class="card p-4">
            <h3 class="mb-4"><i class="fas fa-receipt me-2 text-danger"></i>Order #@Model.Id</h3>
            <p><strong>Customer:</strong> @Model.CustomerName</p>
            <p><strong>Email:</strong> @Model.CustomerEmail</p>
            <p><strong>Date:</strong> @Model.OrderDate.ToString("MMMM dd, yyyy HH:mm")</p>
            <p><strong>Status:</strong> <span class="badge bg-warning text-dark">@Model.Status</span></p>
            <hr/>
            <h5>Items Ordered</h5>
            <table class="table">
                <thead><tr><th>Item</th><th>Qty</th><th>Unit Price</th><th>Subtotal</th></tr></thead>
                <tbody>
                    @foreach (var detail in Model.OrderDetails)
                    {
                        <tr>
                            <td>@detail.MenuItem.Name</td>
                            <td>@detail.Quantity</td>
                            <td>$@detail.UnitPrice.ToString("0.00")</td>
                            <td>$@((detail.Quantity * detail.UnitPrice).ToString("0.00"))</td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr class="fw-bold"><td colspan="3" class="text-end">Total:</td><td class="text-danger">$@Model.TotalAmount.ToString("0.00")</td></tr>
                </tfoot>
            </table>
            <a href="/Order" class="btn btn-outline-secondary mt-2">Back to Orders</a>
        </div>
    </div>
</div>