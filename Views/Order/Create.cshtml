@{ViewData["Title"] = "New Order";}
<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card p-4">
            <h3 class="mb-4"><i class="fas fa-plus-circle me-2 text-danger"></i>New Order</h3>
            <form asp-action="Create" method="post">
                <div class="mb-3">
                    <label class="form-label fw-bold">Customer Name</label>
                    <input name="customerName" class="form-control" required />
                </div>
                <div class="mb-3">
                    <label class="form-label fw-bold">Customer Email</label>
                    <input name="customerEmail" type="email" class="form-control" required />
                </div>
                <h5 class="mt-4 mb-3">Select Items</h5>
                <div class="row g-3">
                    @foreach (var item in ViewBag.MenuItems)
                    {
                        <div class="col-md-6">
                            <div class="card p-3">
                                <div class="d-flex justify-content-between">
                                    <span class="fw-bold">@item.Name</span>
                                    <span class="text-danger">$@item.Price.ToString("0.00")</span>
                                </div>
                                <small class="text-muted">@item.Category</small>
                                <div class="mt-2 d-flex align-items-center gap-2">
                                    <input type="hidden" name="menuItemIds" value="@item.Id" />
                                    <label class="form-label mb-0">Qty:</label>
                                    <input type="number" name="quantities" min="0" value="0" class="form-control form-control-sm w-50" />
                                </div>
                            </div>
                        </div>
                    }
                </div>
                <div class="d-flex gap-2 mt-4">
                    <button type="submit" class="btn btn-primary w-50"><i class="fas fa-check me-2"></i>Place Order</button>
                    <a href="/Order" class="btn btn-outline-secondary w-50">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>