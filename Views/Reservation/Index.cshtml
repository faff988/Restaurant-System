@model List<RestaurantSystem.Models.Reservation>
@{
    ViewData["Title"] = "Manage Bookings";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="fas fa-calendar-alt me-2 text-danger"></i>Manage Bookings</h2>
    <a asp-action="Create" class="btn btn-primary"><i class="fas fa-plus me-2"></i>New Reservation</a>
</div>

<div class="card">
    <table class="table table-hover mb-0 align-middle">
        <thead class="table-dark">
            <tr>
                <th>#</th>
                <th>Customer</th>
                <th>Date & Time</th>
                <th>Guests</th>
                <th>Requests</th>
                <th>Status</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @{ int i = 1; }
            @foreach (var reservation in Model)
            {
                <tr>
                    <td class="text-center fw-bold">@(i++)</td>
                    <td>@reservation.CustomerName<br /><small class="text-muted">@reservation.CustomerEmail</small></td>
                    <td>@reservation.ReservationDate.ToString("MMM dd, yyyy HH:mm")</td>
                    <td class="text-center">@reservation.NumberOfGuests</td>
                    <td>@(string.IsNullOrEmpty(reservation.SpecialRequests) ? "None" : reservation.SpecialRequests)</td>
                    <td><span
                        class="badge @(reservation.Status == "Confirmed" ? "bg-success" : reservation.Status == "Pending" ? "bg-warning text-dark" : "bg-danger")">@reservation.Status</span>
                    </td>
                    <td>
                        <div class="d-flex align-items-center gap-2 justify-content-center">
                            <a asp-action="Details" asp-route-id="@reservation.Id" class="btn btn-outline-primary btn-action shadow-sm" title="View"><i class="fas fa-eye"></i></a>
                            <form asp-action="Delete" asp-route-id="@reservation.Id" method="post" class="m-0" onsubmit="return confirm('Delete permanently?');">
                                <button type="submit" class="btn btn-outline-danger btn-action shadow-sm">
                                    <i class="fas fa-trash"></i>
                                </button>
                            </form>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>