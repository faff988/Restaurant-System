@model RestaurantSystem.Models.Reservation
@{ViewData["Title"] = "Reservation Details";}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="page-header d-flex justify-content-between align-items-center">
            <div>
                <h2 class="mb-0"><i class="fas fa-info-circle me-2"></i>Booking Details</h2>
                <p class="mb-0 opacity-75">Reviewing reservation for @Model.CustomerName</p>
            </div>
            <a asp-action="Index" class="btn btn-outline-light"><i class="fas fa-arrow-left me-2"></i>Back to List</a>
        </div>

        <div class="card shadow-sm">
            <div class="card-body p-4">
                <div class="row mb-4">
                    <div class="col-sm-6">
                        <label class="text-muted small text-uppercase fw-bold">Customer Name</label>
                        <p class="h5">@Model.CustomerName</p>
                    </div>
                    <div class="col-sm-6">
                        <label class="text-muted small text-uppercase fw-bold">Status</label>
                        <div><span class="badge bg-success">@Model.Status</span></div>
                    </div>
                </div>
                <div class="row mb-4">
                    <div class="col-sm-6">
                        <label class="text-muted small text-uppercase fw-bold">Email / Phone</label>
                        <p class="mb-0">@Model.CustomerEmail</p>
                        <p>@Model.CustomerPhone</p>
                    </div>
                    <div class="col-sm-6">
                        <label class="text-muted small text-uppercase fw-bold">Date & Time</label>
                        <p class="h5 text-danger">@Model.ReservationDate.ToString("f")</p>
                    </div>
                </div>
                <hr />
                <label class="text-muted small text-uppercase fw-bold">Special Requests</label>
                <p class="bg-light p-3 rounded" style="min-height: 100px;">@(string.IsNullOrEmpty(Model.SpecialRequests) ? "No special requests provided." : Model.SpecialRequests)</p>
            </div>
        </div>
    </div>
</div>