@model RestaurantSystem.Models.Reservation
@{ViewData["Title"] = "New Reservation";}
<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card p-4">
            <h3 class="mb-4"><i class="fas fa-calendar-plus me-2 text-danger"></i>Book a Table</h3>
            <form asp-action="Create" method="post">
                <div class="mb-3">
                    <label class="form-label fw-bold">Full Name</label>
                    <input asp-for="CustomerName" class="form-control" required />
                </div>
                <div class="mb-3">
                    <label class="form-label fw-bold">Email</label>
                    <input asp-for="CustomerEmail" type="email" class="form-control" required />
                </div>
                <div class="mb-3">
                    <label class="form-label fw-bold">Phone</label>
                    <input asp-for="CustomerPhone" class="form-control" required />
                </div>
                <div class="mb-3">
                    <label class="form-label fw-bold">Date & Time</label>
                    <input asp-for="ReservationDate" type="datetime-local" class="form-control" required />
                </div>
                <div class="mb-3">
                    <label class="form-label fw-bold">Number of Guests</label>
                    <input asp-for="NumberOfGuests" type="number" min="1" max="20" class="form-control" required />
                </div>
                <div class="mb-3">
                    <label class="form-label fw-bold">Special Requests</label>
                    <textarea asp-for="SpecialRequests" class="form-control" rows="2"></textarea>
                </div>
                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary w-50"><i class="fas fa-check me-2"></i>Confirm</button>
                    <a href="/Reservation" class="btn btn-outline-secondary w-50">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>
