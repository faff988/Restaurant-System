@{ViewData["Title"] = "Login";}
<div class="row justify-content-center mt-5">
    <div class="col-md-4">
        <div class="card p-4">
            <h3 class="text-center mb-4"><i class="fas fa-sign-in-alt me-2 text-danger"></i>Login</h3>
            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger">@ViewBag.Error</div>
            }
            <form method="post">
                <div asp-validation-summary="All" class="text-danger small mb-3"></div>
                <div class="mb-3">
                    <label class="form-label fw-bold">Email</label>
                    <input name="email" type="email" class="form-control" required />
                </div>
                <div class="mb-3">
                    <label class="form-label fw-bold">Password</label>
                    <input name="password" type="password" class="form-control" required />
                </div>
                <div class="mb-3 form-check">
                    <input name="rememberMe" type="checkbox" class="form-check-input" />
                    <label class="form-check-label">Remember Me</label>
                </div>
                <button type="submit" class="btn btn-primary w-100">Login</button>
            </form>
            <hr/>
            <p class="text-center">Don't have an account? <a asp-action="Register">Register</a></p>
        </div>
    </div>
</div>