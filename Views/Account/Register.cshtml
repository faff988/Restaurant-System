@{ViewData["Title"] = "Register";}
<div class="row justify-content-center mt-5">
    <div class="col-md-4">
        <div class="card p-4">
            <h3 class="text-center mb-4"><i class="fas fa-user-plus me-2 text-danger"></i>Register</h3>
            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger">@ViewBag.Error</div>
            }
            <form method="post">
                <div asp-validation-summary="All" class="text-danger small mb-3"></div>
                <div class="mb-3">
                    <label class="form-label fw-bold">Email</label>
                    <input name="email" type="email" class="form-control" required />
                </div>
                <div class="mb-3">
                    <label class="form-label fw-bold">Password</label>
                    <input name="password" type="password" class="form-control" required />
                </div>
                <button type="submit" class="btn btn-primary w-100">Register</button>
            </form>
            <hr/>
            <p class="text-center mb-0">Already have an account? <a asp-action="Login" class="text-danger fw-bold">Login</a></p>
        </div>
    </div>
</div>