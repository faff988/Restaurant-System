@{
    ViewData["Title"] = "Home";
}

<div class="page-header text-center py-5 mb-4">
    <h1 class="display-5 fw-bold mb-2">🍽️ Welcome to RestaurantSystem</h1>
    <p class="lead opacity-75 mb-4">Delicious food · Seamless ordering · Easy reservations</p>
    <a href="/Menu" class="btn btn-light btn-lg me-3 px-4"><i class="fas fa-book-open me-2"></i>View Menu</a>
    <a href="/Reservation/Create" class="btn btn-outline-light btn-lg px-4"><i class="fas fa-calendar me-2"></i>Book a
        Table</a>
    </div>

    <div class="row g-4 mb-5">
        <div class="col-md-4">
            <div class="card p-4 text-center h-100">
                <div class="mb-3" style="font-size:3rem">🍔</div>
                <h5 class="fw-bold">Our Menu</h5>
                <p class="text-muted small">Browse our wide selection of delicious dishes and drinks crafted by our chefs
                </p>
                <a href="/Menu" class="btn btn-primary mt-auto">Explore Menu</a>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card p-4 text-center h-100">
                <div class="mb-3" style="font-size:3rem">🛒</div>
                <h5 class="fw-bold">Place an Order</h5>
                <p class="text-muted small">Order your favourite meals quickly and easily from our online system</p>
                <a href="/Order/Create" class="btn btn-primary mt-auto">Order Now</a>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card p-4 text-center h-100">
                <div class="mb-3" style="font-size:3rem">📅</div>
                <h5 class="fw-bold">Reservations</h5>
                <p class="text-muted small">Book a table for your next visit and enjoy a wonderful dining experience</p>
                <a href="/Reservation/Create" class="btn btn-primary mt-auto">Book Now</a>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-md-3">
            <div class="stat-card" style="background: linear-gradient(135deg, #667eea, #764ba2);">
                <div style="font-size:2rem">📋</div>
                <h2 class="fw-bold mt-2">@ViewBag.TotalMenuItems</h2>
                <p class="opacity-75 mb-0">Menu Items</p>
            </div>
        </div>
        <div class="col-md-3">
            <div class="stat-card" style="background: linear-gradient(135deg, #f093fb, #f5576c);">
                <div style="font-size:2rem">🛒</div>
                <h2 class="fw-bold mt-2">@ViewBag.TotalOrders</h2>
                <p class="opacity-75 mb-0">Total Orders</p>
            </div>
        </div>
        <div class="col-md-3">
            <div class="stat-card" style="background: linear-gradient(135deg, #4facfe, #00f2fe);">
                <div style="font-size:2rem">📅</div>
                <h2 class="fw-bold mt-2">@ViewBag.TotalReservations</h2>
                <p class="opacity-75 mb-0">Reservations</p>
            </div>
        </div>
        <div class="col-md-3">
            <div class="stat-card" style="background: linear-gradient(135deg, #43e97b, #38f9d7);">
                <div style="font-size:2rem">💰</div>
                <h2 class="fw-bold mt-2">$@string.Format("{0:0.00}", ViewBag.TotalRevenue)</h2>
                <p class="opacity-75 mb-0">Total Revenue</p>
            </div>
        </div>
    </div>
